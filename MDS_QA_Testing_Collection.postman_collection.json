    {
      "name": "2. Public Registry APIs (Read-Only)",
      "item": [
        {
          "name": "2.1 List All Published Catalogs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_url}}/public/datasets",
              "host": [
                "{{api_url}}"
              ],
              "path": [
                "public",
                "datasets"
              ]
            }
          }
        },
        {
          "name": "2.2 Get Entries for a Catalog",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_url}}/public/datasets/{{list_code}}/entries?page=1&limit=50",
              "host": [

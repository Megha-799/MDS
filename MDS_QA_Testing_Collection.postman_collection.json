    {
      "name": "3. Approval Workflow (Maker-Checker Lifecycle)",
      "item": [
        {
          "name": "3.1 [All] Query Catalogs & Open Drafts",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{maker_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"request_header\": {\n    \"sender_app_mnemonic\": \"farmer-registry-staff-portal\",\n    \"sender_app_url\": \"http://localhost:3005\",\n    \"request_id\": \"{{$guid}}\",\n    \"request_timestamp\": \"{{$isoTimestamp}}\"\n  },\n  \"request_body\": {\n    \"request_payload\": {}\n  }\n}"
            },
            "url": {
              "raw": "{{api_url}}/catalogue/get_lists",
              "host": [
                "{{api_url}}"
              ],
              "path": [
                "catalogue",
                "get_lists"
              ]
            }
          }
        },
        {
          "name": "3.2 [Maker] Create Draft Version",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{maker_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"request_header\": {\n    \"sender_app_mnemonic\": \"farmer-registry-staff-portal\",\n    \"sender_app_url\": \"http://localhost:3005\",\n    \"request_id\": \"{{$guid}}\",\n    \"request_timestamp\": \"{{$isoTimestamp}}\"\n  },\n  \"request_body\": {\n    \"request_payload\": {\n      \"list_code\": \"{{list_code}}\",\n      \"change_note\": \"Draft created by QA Maker\"\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{api_url}}/catalogue/create_list_draft",
              "host": [
                "{{api_url}}"
              ],
              "path": [
                "catalogue",
                "create_list_draft"
              ]
            }
          }
        },
        {
          "name": "3.3 [Maker] Upsert New Entry into Draft",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{maker_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"request_header\": {\n    \"sender_app_mnemonic\": \"farmer-registry-staff-portal\",\n    \"sender_app_url\": \"http://localhost:3005\",\n    \"request_id\": \"{{$guid}}\",\n    \"request_timestamp\": \"{{$isoTimestamp}}\"\n  },\n  \"request_body\": {\n    \"request_payload\": {\n      \"list_code\": \"{{list_code}}\",\n      \"values\": [\n        {\n          \"value_code\": \"{{test_value_code}}\",\n          \"display\": \"QA Verification Test Entry\",\n          \"display_i18n\": {\n            \"am\": \"\\u12e8\\u1219\\u12a8\\u122b \\u130d\\u1264\\u1275\"\n          },\n          \"sort_order\": 9999,\n          \"status\": \"ACTIVE\",\n          \"attributes\": {\n            \"qa_tested\": true,\n            \"budget_year\": 2026\n          }\n        }\n      ]\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{api_url}}/catalogue/upsert_draft_values",
              "host": [
                "{{api_url}}"
              ],
              "path": [
                "catalogue",
                "upsert_draft_values"
              ]
            }
          }
        },
        {
          "name": "3.4 [Maker] View Draft Values",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{maker_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"request_header\": {\n    \"sender_app_mnemonic\": \"farmer-registry-staff-portal\",\n    \"sender_app_url\": \"http://localhost:3005\",\n    \"request_id\": \"{{$guid}}\",\n    \"request_timestamp\": \"{{$isoTimestamp}}\"\n  },\n  \"request_body\": {\n    \"request_payload\": {\n      \"list_code\": \"{{list_code}}\"\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{api_url}}/catalogue/get_list_values",
              "host": [
                "{{api_url}}"
              ],
              "path": [
                "catalogue",
                "get_list_values"
              ]
            }
          }
        },
        {
          "name": "3.5 [Maker] Submit Draft for Approval",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{maker_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"request_header\": {\n    \"sender_app_mnemonic\": \"farmer-registry-staff-portal\",\n    \"sender_app_url\": \"http://localhost:3005\",\n    \"request_id\": \"{{$guid}}\",\n    \"request_timestamp\": \"{{$isoTimestamp}}\"\n  },\n  \"request_body\": {\n    \"request_payload\": {\n      \"list_code\": \"{{list_code}}\",\n      \"change_note\": \"QA test batch submitted for checker review\"\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{api_url}}/catalogue/submit_draft",
              "host": [
                "{{api_url}}"
              ],
              "path": [
                "catalogue",
                "submit_draft"
              ]
            }
          }
        },
        {
          "name": "3.6 [Checker] Approve & Publish Draft",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{checker_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"request_header\": {\n    \"sender_app_mnemonic\": \"farmer-registry-staff-portal\",\n    \"sender_app_url\": \"http://localhost:3005\",\n    \"request_id\": \"{{$guid}}\",\n    \"request_timestamp\": \"{{$isoTimestamp}}\"\n  },\n  \"request_body\": {\n    \"request_payload\": {\n      \"list_code\": \"{{list_code}}\",\n      \"decision_note\": \"Verified by QA Checker. Approved for production.\"\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{api_url}}/catalogue/approve_draft",
              "host": [
                "{{api_url}}"
              ],
              "path": [
                "catalogue",
                "approve_draft"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4. Negative & Governance Tests",
      "item": [
        {
          "name": "4.1 [Security] Maker Self-Approval Attempt (Expect 403 Forbidden)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('System rejects self-approval with 403 or error', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([400, 403]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{maker_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"request_header\": {\n    \"sender_app_mnemonic\": \"farmer-registry-staff-portal\",\n    \"sender_app_url\": \"http://localhost:3005\",\n    \"request_id\": \"{{$guid}}\",\n    \"request_timestamp\": \"{{$isoTimestamp}}\"\n  },\n  \"request_body\": {\n    \"request_payload\": {\n      \"list_code\": \"{{list_code}}\",\n      \"decision_note\": \"Attempting unauthorized self approval\"\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{api_url}}/catalogue/approve_draft",
              "host": [
                "{{api_url}}"
              ],
              "path": [
                "catalogue",
                "approve_draft"
              ]
            }
          }
        },
        {
          "name": "4.2 [Checker] Reject Draft with Mandatory Reason",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{checker_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"request_header\": {\n    \"sender_app_mnemonic\": \"farmer-registry-staff-portal\",\n    \"sender_app_url\": \"http://localhost:3005\",\n    \"request_id\": \"{{$guid}}\",\n    \"request_timestamp\": \"{{$isoTimestamp}}\"\n  },\n  \"request_body\": {\n    \"request_payload\": {\n      \"list_code\": \"{{list_code}}\",\n      \"decision_note\": \"Rejected due to invalid botanical category code\"\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{api_url}}/catalogue/reject_draft",
              "host": [
                "{{api_url}}"
              ],
              "path": [
                "catalogue",
                "reject_draft"
              ]
            }
          }
        },
        {
          "name": "4.3 [Maker] Discard Unsubmitted Draft",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{maker_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"request_header\": {\n    \"sender_app_mnemonic\": \"farmer-registry-staff-portal\",\n    \"sender_app_url\": \"http://localhost:3005\",\n    \"request_id\": \"{{$guid}}\",\n    \"request_timestamp\": \"{{$isoTimestamp}}\"\n  },\n  \"request_body\": {\n    \"request_payload\": {\n      \"list_code\": \"{{list_code}}\"\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{api_url}}/catalogue/discard_draft",
              "host": [
                "{{api_url}}"
              ],
              "path": [
                "catalogue",
                "discard_draft"
              ]
            }
          }
        }
      ]
    }
  ]
